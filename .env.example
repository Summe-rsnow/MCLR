# MCLR Runtime Secrets Configuration
# Copy this file to .env and configure your keys as needed.
# Note: .env is git-ignored and will NEVER be committed to repository.

# Microsoft OAuth 2.0 Client ID (Device Code Flow)
MCLR_MS_CLIENT_ID=

# CurseForge API Key from https://console.curseforge.com/#/api-keys
MCLR_CURSEFORGE_API_KEY=

# Optional: Self-updater endpoints
# MCLR_UPDATE_ENDPOINT=https://updates.example.com/mclr/latest.json
# MCLR_UPDATE_PUBKEY=
