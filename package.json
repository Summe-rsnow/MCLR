{
  "name": "mclr",
  "private": true,
  "version": "0.0.32",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MCLR-Team/MCLR/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "gen:bindings": "cargo test -p mclr-app --test export_bindings -- --nocapture",
    "lint": "oxlint",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.148",
    "@lobehub/webfont-harmony-sans-sc": "1.0.0",
    "@tanstack/vue-virtual": "^3.13.49",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "culori": "^4.0.2",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.101",
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5.9.3",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
